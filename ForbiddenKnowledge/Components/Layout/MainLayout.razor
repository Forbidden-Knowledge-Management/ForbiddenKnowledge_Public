@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4 flex-grow-1 d-flex flex-column bg-dark text-white">
            @Body
        </article>

        <footer class="bg-secondary text-white py-3">
            <div class="container text-center">
                <p class="mb-0">© @DateTime.UtcNow.Year Forbidden-Knowledge.com. All Rights Reserved.</p>
                <p class="mb-0">
                    <a href="/privacy" class="footer-link">Privacy Policy</a> |
                    <a href="/terms" class="footer-link">Terms of Use</a>
                </p>
            </div>
        </footer>

        <audio id="background-music" autoplay loop>
            <source src="music/Temple_of_Light.mp3" type="audio/mpeg">
            Your browser does not support the audio element.
        </audio>

    </main>

</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
