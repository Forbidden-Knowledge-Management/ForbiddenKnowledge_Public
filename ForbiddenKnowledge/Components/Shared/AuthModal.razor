@using ForbiddenKnowledge.Data
@using ForbiddenKnowledge.Services
@inject IAuthService _authService

<div class="modal" style="display:@(ShowModal ? "block" : "none")">
    <div class="modal-content">
        <span class="close" @onclick="CloseModal">&times;</span>
        <h3>@(IsLoginMode ? "Login" : "Register")</h3>

        @if (IsLoginMode)
        {
            switch (loginState)
            {
                case LoginFrontEndType.Login:

                    <p>
                        If you already have an account on Forbidden Knowledge, please enter your pseudonym and password below to login.
                        If you do not have an account and would like to make one, please click the "Switch to Register" button.
                        If you have forgotten your password or pseudonym, please use the "Reset Password" button.
                    </p>

                    <EditForm class="form" Model="@loginModel" OnValidSubmit="SubmitLogin">
                        <DataAnnotationsValidator />
                        @* <ValidationSummary /> *@

                        <div class="form-item">
                            <label class="label" for="Pseudonym">Pseudonym:</label>
                            <InputText class="form-input" id="Pseudonym" @bind-Value="loginModel.Pseudonym" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Pseudonym)" />

                        <div class="form-item">
                            <label class="label" for="password">Password:</label>
                            <PasswordInput Value="@loginModel.Password" ValueChanged="@((value) => loginModel.Password = value)" />
                        </div>
                        <ValidationMessage For="@(() => loginModel.Password)" />

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }

                        <div class="flex-container-row">
                            <button class="blue-button auth-modal-buttons" @onclick="SwitchToPasswordResetRequestFrontend">Reset Password</button>
                            <button class="blue-button auth-modal-buttons" type="submit">Login</button>
                        </div>

                    </EditForm>

                    break;

                case LoginFrontEndType.PasswordResetRequest:

                    <p>
                        To reset your password, you must provide either the pseudonym or email address associated with your account.
                        Pseudonym is preffered, but if you have forgotten your pseudonym, your account can still be retrieved by providing the email address associated with your account.
                        An email will then by sent to you with a password reset code. This email will include your pseudonym in case you forgot it.
                    </p>

                    <EditForm class="form" Model="@passwordResetRequestModel" OnValidSubmit="RequestPasswordReset">
                        <DataAnnotationsValidator />
                        @* <ValidationSummary /> *@

                        <div class="form-item">
                            <label class="label-large" for="PseudonymOrEmail">Pseudonym/Email Address:</label>
                            <InputText class="form-input" id="PseudonymOrEmail" @bind-Value="passwordResetRequestModel.PseudonymOrEmail" />
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                        <button class="blue-button auth-modal-buttons " type="submit">Send Password Reset Email</button>
                    </EditForm>

                    break;

                case LoginFrontEndType.PasswordReset:

                    <EditForm class="form" Model="@passwordResetModel" OnValidSubmit="PasswordReset">
                        <DataAnnotationsValidator />

                        <div class="form-item">
                            <label class="label-medium" for="Pseudonym">Pseudonym:</label>
                            <InputText class="form-input" id="Pseudonym" @bind-Value="passwordResetModel.Pseudonym" />
                        </div>
                        <ValidationMessage For="@(() => passwordResetModel.Pseudonym)" />

                        <div class="form-item">
                            <label class="label-medium" for="ResetCode">Reset Code:</label>
                            <InputText class="form-input" id="ResetCode" @bind-Value="passwordResetModel.ResetCode" />
                        </div>
                        <ValidationMessage For="@(() => passwordResetModel.ResetCode)" />

                        <div class="form-item">
                            <label class="label-medium" for="password">New Password:</label>
                            <PasswordInput Value="@passwordResetModel.Password" ValueChanged="@((value) => passwordResetModel.Password = value)" />
                        </div>
                        <ValidationMessage For="@(() => passwordResetModel.Password)" />

                        <button class="blue-button auth-modal-buttons" type="submit">Reset Password</button>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger">@errorMessage</div>
                        }
                    </EditForm>

                    break;
            }
        }
        else
        {
            <p>
                This is for registering a new account.
                If you already have a Forbidden Knowledge account, please click the "Switch to Login" button to login.
            </p>

            <p>
                We highly reccomend using a dedicated password manager such as <a href="https://www.keepersecurity.com" target="_blank">Keeper</a> or <a href="https://1password.com" target="_blank">1Password</a> to generate secure passwords and manage various accounts.
            </p>

            <EditForm class="form" Model="@registerModel" OnValidSubmit="SubmitRegistration">
                <DataAnnotationsValidator />
                @* <ValidationSummary /> *@

                <div class="form-item">
                    <label class="label" for="Pseudonym">Pseudonym:</label>
                    <InputText class="form-input" id="Pseudonym" @bind-Value="registerModel.Pseudonym" />
                </div>
                <ValidationMessage For="@(() => registerModel.Pseudonym)" />

                <div class="form-item">
                    <label class="label" for="Email">Email:</label>
                    <InputText class="form-input" id="Email" @bind-Value="registerModel.Email" />
                </div>
                <ValidationMessage For="@(() => registerModel.Email)" />

                <div class="form-item">
                    <label class="label" for="password">Password:</label>
                    <PasswordInput Value="@registerModel.Password" ValueChanged="@((value) => registerModel.Password = value)" />
                </div>
                <ValidationMessage For="@(() => registerModel.Password)" />

                <button class="blue-button auth-modal-buttons" type="submit">Register</button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@((MarkupString)errorMessage)</div>
                }
            </EditForm>
        }

        <button class="blue-button auth-modal-buttons login-register-switch-button" @onclick="ToggleMode">@((IsLoginMode ? "Switch to Register" : "Switch to Login"))</button>
    </div>
</div>

@code
{
    [Parameter] 
    public bool ShowModal { get; set; }

    [Parameter] 
    public EventCallback<bool> ShowModalChanged { get; set; }

    private bool IsLoginMode = true;
    private LoginFrontEndType loginState = LoginFrontEndType.Login; 

    private LoginModel loginModel = new();
    private RegisterModel registerModel = new();
    private PasswordResetRequestModel passwordResetRequestModel = new();
    private PasswordResetModel passwordResetModel = new();

    public string errorMessage { get; set; }

    private async Task SubmitLogin()
    {
        var(succeeded, error) = await _authService.LoginFullAccountAsync(loginModel);
        if (succeeded)
        {
            // Notify parent to close popup
            await ShowModalChanged.InvokeAsync(false);

            //clear input fields
            loginModel = new LoginModel();
        }
        else
        {
            errorMessage = error;
        }
    }

    private async Task SubmitRegistration()
    {
        var(succeeded, error) = await _authService.CreateFullAccount(registerModel);
        if (succeeded)
        {
            // Notify parent to close popup
            await ShowModalChanged.InvokeAsync(false);

            //clear input fields
            registerModel = new RegisterModel();
        }
        else
        {
            errorMessage = error;
        }
    }

    private void ToggleMode()
    {
        IsLoginMode = !IsLoginMode;
    }

    private void CloseModal()
    {
        ShowModal = false;
        ShowModalChanged.InvokeAsync(ShowModal);
    }


    [JSInvokable]
    public void ReceiveFullAccountLoginError(string message)
    {
        errorMessage = message;
        StateHasChanged();
    }

    private async Task SwitchToPasswordResetRequestFrontend()
    {
        loginState = LoginFrontEndType.PasswordResetRequest;
    }

    private async Task RequestPasswordReset()
    {
        var (succeeded, error) = await _authService.RequestPasswordResetAsync(passwordResetRequestModel);
        if (succeeded)
        {
            //this means a password reset email was sent, so we need to switch the frontend tp
            loginState = LoginFrontEndType.PasswordReset;

            //clear input fields
            passwordResetRequestModel = new PasswordResetRequestModel();
        }
        else
        {
            errorMessage = error;
        }
    }  

    private async Task PasswordReset()
    {
        var (succeeded, error) = await _authService.PasswordResetAsync(passwordResetModel);
        if (succeeded)
        {
            //PW reset was successful. User must now log back in themselves, since security stamp was reset.
            loginState = LoginFrontEndType.Login;

            //clear input fields
            passwordResetModel = new PasswordResetModel();
        }
        else
        {
            errorMessage = error;
        }

    }


}









