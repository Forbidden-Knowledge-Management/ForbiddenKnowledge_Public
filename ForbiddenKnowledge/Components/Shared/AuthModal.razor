@using ForbiddenKnowledge.Data
@using ForbiddenKnowledge.Services
@inject HttpClient HttpClient
@inject NavigationManager NavigationManager
@inject IAuthService authService

<div class="modal" style="display:@(ShowModal ? "block" : "none")">
    <div class="modal-content">
        <span class="close" @onclick="CloseModal">&times;</span>
        <h3>@(IsLoginMode ? "Login" : "Register")</h3>

        @if (IsLoginMode)
        {
            <p>
                If you already have an account on Forbidden Knowledge, please enter your Pseudonym and Password below to login.
                If you do not have an account and would like to make one, please click the "Switch to Register" button.
            </p>

            <EditForm class="form" Model="@LoginModel" OnValidSubmit="SubmitLogin">
                <DataAnnotationsValidator />
                @* <ValidationSummary /> *@

                <div class="form-item">
                    <label class="label" for="Pseudonym">Pseudonym:</label>
                    <InputText class="form-input" id="Pseudonym" @bind-Value="LoginModel.Pseudonym" />
                </div>
                <ValidationMessage For="@(() => LoginModel.Pseudonym)" />

                <div class="form-item">
                    <label class="label" for="password">Password:</label>
                    <PasswordInput Value="@LoginModel.Password" ValueChanged="@((value) => LoginModel.Password = value)" />
                </div>
                <ValidationMessage For="@(() => LoginModel.Password)" />

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                <button class="blue-button register-login-switch-button" type="submit">Login</button>
            </EditForm>
        }
        else
        {
            <p>
                This is for registering a new account.
                If you already have a Forbidden Knowledge account, please click the "Switch to Login" button to login.
            </p>

            <p>
                We highly reccomend using a dedicated password manager such as <a href="https://www.keepersecurity.com" target="_blank">Keeper</a> or <a href="https://1password.com" target="_blank">1Password</a> to generate secure passwords and manage various accounts.
            </p>

            <EditForm class="form" Model="@RegisterModel" OnValidSubmit="SubmitRegistration">
                <DataAnnotationsValidator />
                @* <ValidationSummary /> *@

                <div class="form-item">
                    <label class="label" for="Pseudonym">Pseudonym:</label>
                    <InputText class="form-input" id="Pseudonym" @bind-Value="RegisterModel.Pseudonym" />
                </div>
                <ValidationMessage For="@(() => RegisterModel.Pseudonym)" />

                <div class="form-item">
                    <label class="label" for="Email">Email:</label>
                    <InputText class="form-input" id="Email" @bind-Value="RegisterModel.Email" />
                </div>
                <ValidationMessage For="@(() => RegisterModel.Email)" />

                <div class="form-item">
                    <label class="label" for="password">Password:</label>
                    <PasswordInput Value="@RegisterModel.Password" ValueChanged="@((value) => RegisterModel.Password = value)" />
                </div>
                <ValidationMessage For="@(() => RegisterModel.Password)" />

                <button class="blue-button register-login-switch-button" type="submit">Register</button>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
            </EditForm>
        }

        <button class="blue-button register-login-switch-button" @onclick="ToggleMode">@((IsLoginMode ? "Switch to Register" : "Switch to Login"))</button>
    </div>
</div>

@code
{
    [Parameter] 
    public bool ShowModal { get; set; }

    [Parameter] 
    public EventCallback<bool> ShowModalChanged { get; set; }

    private bool IsLoginMode = true;

    private LoginModel LoginModel = new();
    private RegisterModel RegisterModel = new();

    public string errorMessage { get; set; }

    private async Task SubmitLogin()
    {
        var(succeeded, error) = await authService.LoginFullAccountAsync(LoginModel);
        if (succeeded)
        {
            // Notify parent to close popup
            await ShowModalChanged.InvokeAsync(false);

            //clear input fields
            LoginModel = new LoginModel();
        }
        else
        {
            errorMessage = error;
        }
    }

    private async Task SubmitRegistration()
    {
        try
        {
            HttpResponseMessage response = await HttpClient.PostAsJsonAsync($"{NavigationManager.BaseUri}api/users/register", RegisterModel);
            if (response.IsSuccessStatusCode)
            {
                //so the new user is now registered, but we now need to log them in
                var loginModel = new LoginModel
                {
                    Pseudonym = RegisterModel.UppercasedPseudonym,
                    Password = RegisterModel.Password
                };

                //Attempt automatic login after registration
                var(succeeded, error) = await authService.LoginFullAccountAsync(loginModel);
                if (succeeded)
                {
                    // Notify parent about successful login, close popup
                    await ShowModalChanged.InvokeAsync(false);
                }
                else
                {
                    errorMessage = $"Registration successful, but login failed due to {error}. Please attempt to log in manually.";
                }

                //Clear input fields
                RegisterModel = new RegisterModel();               
            }
            else
            {
                string errorDetails = await response.Content.ReadAsStringAsync();
                errorMessage = $"Registration failed: {errorDetails}";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An unexpected error occurred during registration. Please try again later.";
            //_logger.LogError(ex, "Registration failed for user {Email}", RegisterModel.Email);
        }
    }

    private void ToggleMode()
    {
        IsLoginMode = !IsLoginMode;
    }

    private void CloseModal()
    {
        ShowModal = false;
        ShowModalChanged.InvokeAsync(ShowModal);
    }
}









